# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Random secret used to sign the staff login session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 32-byte (64 hex char) key used to encrypt/decrypt staff PINs so admins can
# view them. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PIN_ENCRYPTION_KEY=
